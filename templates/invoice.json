{
  "id": "invoice",
  "name": "General Commercial Invoice",
  "description": "Standard business invoice with line items, tax, and total",
  "fields": [
    {
      "name": "Invoice Number",
      "type": "code",
      "labels": ["Invoice Number", "Invoice No", "Inv #", "Bill No"],
      "urdu_labels": ["?????? ????", "?? ????"],
      "min_digits": 4,
      "max_digits": 12,
      "required": true,
      "confidence_threshold": 0.65
    },
    {
      "name": "Subtotal",
      "type": "decimal",
      "labels": ["Subtotal", "Sub Total", "Net Amount"],
      "urdu_labels": ["?? ??? ???? ????"],
      "min_value": 0,
      "max_value": 10000000,
      "required": true,
      "decimal_allowed": true,
      "confidence_threshold": 0.65
    },
    {
      "name": "Tax Amount",
      "type": "decimal",
      "labels": ["Sales Tax Amount", "Tax Amount", "Sales Tax", "GST Amount", "VAT Amount"],
      "urdu_labels": ["???? ????", "????"],
      "min_value": 0,
      "max_value": 1000000,
      "required": true,
      "decimal_allowed": true,
      "confidence_threshold": 0.65
    },
    {
      "name": "Grand Total",
      "type": "decimal",
      "labels": ["Grand Total", "Total Payable", "Balance Due", "Total Due"],
      "urdu_labels": ["?? ?????", "?? ???? ?????"],
      "min_value": 0,
      "max_value": 10000000,
      "required": true,
      "decimal_allowed": true,
      "confidence_threshold": 0.65
    }
  ],
  "cross_field_rules": [
    {
      "rule_name": "tax_total_check",
      "description": "Grand Total should equal Subtotal plus Tax Amount",
      "rule_type": "sum_equals",
      "target_field": "Grand Total",
      "operands": ["Subtotal", "Tax Amount"],
      "tolerance": 1.0
    }
  ]
